
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Anyone can read products
    match /products/{productId} {
      allow read: if true;
      allow write: if false; // Protect your product data from client-side writes
    }

    match /syncHistory/{logId} {
      allow read: if true;
      allow write: if false;
    }

    // Logged-in users can create orders (via secure server action).
    // Users can only read their own orders.
    match /orders/{orderId} {
      // Allow create only from authenticated requests. The server action will be authenticated.
      allow create: if request.auth != null;
      
      // Users can only read orders where their UID matches the document's userId.
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // Do not allow clients to update or delete orders.
      allow update, delete: if false; 
    }
  }
}
